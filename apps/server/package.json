{
  "name": "@couchpotato/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "host": "tsx src/cli.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@couchpotato/shared": "*",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
